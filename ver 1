  document.querySelector('.h-title .ghost').style.cssText='opacity:0;transform:translateY(20px);transition:opacity .8s cubic-bezier(.16,1,.3,1) .1s,transform .8s cubic-bezier(.16,1,.3,1) .1s;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.22)';
  document.querySelector('.h-sub').style.cssText='opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.16,1,.3,1) .25s,transform .7s cubic-bezier(.16,1,.3,1) .25s';
  document.querySelector('.h-desc').style.cssText='opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.16,1,.3,1) .35s,transform .7s cubic-bezier(.16,1,.3,1) .35s';
  document.querySelector('.h-cta').style.cssText='opacity:0;transform:translateY(20px);transition:opacity .6s cubic-bezier(.16,1,.3,1) .5s,transform .6s cubic-bezier(.16,1,.3,1) .5s,background .2s,border-color .2s,color .2s';

  requestAnimationFrame(()=>{
    setTimeout(()=>{
      ['.h-title span:first-child','.h-title .ghost','.h-sub','.h-desc','.h-cta'].forEach(sel=>{
        const el=document.querySelector(sel);
        if(el){ el.style.opacity='1'; el.style.transform='none'; }
      });
    },120);
  });
});
