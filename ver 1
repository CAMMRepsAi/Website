<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>CAMM Reps — Component Manufacturing Representatives</title>
<meta name="description" content="CAMM Reps connects Portwell America, Left Coast Engineering & Brightworks Technologies to critical industry customers across Southern California.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='5' fill='%23050810'/><text x='3' y='24' font-size='21' font-weight='900' fill='%2300b8ff' font-family='Arial'>C</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,300;0,700;0,800;0,900;1,300;1,400&family=Space+Mono:wght@400;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

<style>
/* ═══════ RESET ═══════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

/* ═══════ VARIABLES ═══════ */
:root{
  --bg:#05080f;
  --bg2:#080d18;
  --surface:#0a1220;
  --bd:rgba(80,130,200,0.08);
  --blue:#00b8ff;
  --blue-dim:rgba(0,184,255,0.12);
  --green:#00d490;
  --green-dim:rgba(0,212,144,0.12);
  --gold:#e8941a;
  --gold-dim:rgba(232,148,26,0.12);
  --text:#c4d4e4;
  --dim:#3a5068;
  --ease:cubic-bezier(.16,1,.3,1);
  --d:'Barlow Condensed',sans-serif;
  --m:'Space Mono',monospace;
  --b:'DM Sans',system-ui,sans-serif;
}

html{font-size:16px;scroll-behavior:smooth}
body{font-family:var(--b);background:var(--bg);color:var(--text);overflow-x:hidden;cursor:none}
::selection{background:rgba(0,184,255,.25);color:#fff}
a{color:inherit;text-decoration:none}
img,svg{display:block}

/* ═══════ CURSOR ═══════ */
#cur{
  position:fixed;top:0;left:0;z-index:9999;pointer-events:none;
  width:10px;height:10px;border-radius:50%;background:var(--blue);
  transform:translate(-50%,-50%);transition:width .2s,height .2s,background .2s;
}
#cur-ring{
  position:fixed;top:0;left:0;z-index:9998;pointer-events:none;
  width:36px;height:36px;border-radius:50%;border:1px solid rgba(0,184,255,.35);
  transform:translate(-50%,-50%);
  transition:width .3s var(--ease),height .3s var(--ease),transform .12s;
}
body.hov #cur{width:6px;height:6px;background:#fff}
body.hov #cur-ring{width:50px;height:50px;border-color:rgba(0,184,255,.6)}

/* ═══════ NAV ═══════ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 48px;
  background:rgba(5,8,15,.75);
  backdrop-filter:blur(14px);
  border-bottom:1px solid transparent;
  transition:border-color .4s,padding .3s;
}
nav.scrolled{border-color:var(--bd)}
.nav-logo{
  font-family:var(--m);font-size:.72rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--blue);
}
.nav-links{display:flex;gap:36px}
.nav-links a{
  font-family:var(--m);font-size:.58rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim);
  transition:color .2s;
}
.nav-links a:hover{color:var(--text)}

/* ═══════ HERO ═══════ */
#hero{
  position:relative;height:100svh;min-height:620px;
  display:flex;flex-direction:column;justify-content:center;
  padding:80px 48px 80px;overflow:hidden;
}
#heroCanvas{position:absolute;inset:0;z-index:0}
.h-vignette{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse at 35% 50%,transparent 25%,rgba(5,8,15,.65) 60%,rgba(5,8,15,.96) 100%);
}
.h-content{position:relative;z-index:2;max-width:860px}

.h-overline{
  display:flex;align-items:center;gap:12px;margin-bottom:24px;
  font-family:var(--m);font-size:.56rem;letter-spacing:.26em;
  text-transform:uppercase;color:var(--blue);opacity:.8;
}
.h-overline::before{content:'';display:inline-block;width:28px;height:1px;background:var(--blue)}

.h-title{
  font-family:var(--d);font-weight:900;text-transform:uppercase;
  font-size:clamp(80px,13.5vw,200px);line-height:.85;
  letter-spacing:-.02em;color:#fff;
}
.h-title .ghost{
  display:block;color:transparent;
  -webkit-text-stroke:1px rgba(255,255,255,.22);
  padding-left:4px;
}

.h-sub{
  font-family:var(--d);font-weight:300;font-style:italic;
  font-size:clamp(14px,1.8vw,22px);letter-spacing:.06em;
  color:rgba(196,212,228,.5);margin-top:18px;
}
.h-desc{
  font-size:.92rem;line-height:1.7;color:rgba(196,212,228,.5);
  max-width:400px;margin-top:20px;
}
.h-cta{
  display:inline-flex;align-items:center;gap:10px;margin-top:40px;
  padding:13px 28px;border:1px solid rgba(0,184,255,.35);color:var(--blue);
  font-family:var(--m);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;
  transition:background .2s,border-color .2s,color .2s,transform .2s;
}
.h-cta:hover{background:var(--blue-dim);border-color:var(--blue);color:#fff;transform:translateY(1px)}
.h-cta-arr{transition:transform .2s}
.h-cta:hover .h-cta-arr{transform:translateY(3px)}

/* Hero partner strip */
.h-strip{
  position:absolute;bottom:0;left:0;right:0;z-index:2;
  display:flex;border-top:1px solid var(--bd);
}
.h-strip-item{
  flex:1;padding:20px 32px;display:flex;flex-direction:column;gap:5px;
  border-right:1px solid var(--bd);
  transition:background .3s;
}
.h-strip-item:last-child{border-right:none}
.h-strip-item:hover{background:rgba(0,184,255,.04)}
.h-strip-label{
  font-family:var(--m);font-size:.48rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--dim);
}
.h-strip-name{
  font-family:var(--d);font-weight:700;font-size:1rem;
  text-transform:uppercase;letter-spacing:.04em;
  color:rgba(196,212,228,.6);
}
.h-strip-item[data-color="blue"]:hover .h-strip-name{color:var(--blue)}
.h-strip-item[data-color="green"]:hover .h-strip-name{color:var(--green)}
.h-strip-item[data-color="gold"]:hover .h-strip-name{color:var(--gold)}

/* ═══════ PARTNERS SECTION ═══════ */
#partners{background:var(--bg)}

.p-card{
  display:grid;grid-template-columns:1fr 1fr;
  min-height:85vh;position:relative;
  border-bottom:1px solid var(--bd);
}
.p-card.reverse{direction:rtl}
.p-card.reverse > *{direction:ltr}

.p-info{
  padding:80px 60px 80px 72px;
  display:flex;flex-direction:column;justify-content:center;
  position:relative;overflow:hidden;
}
.p-card.reverse .p-info{padding:80px 72px 80px 60px}

.p-bg-num{
  position:absolute;right:-20px;top:50%;transform:translateY(-50%);
  font-family:var(--d);font-weight:900;font-size:clamp(180px,22vw,320px);
  line-height:1;color:transparent;
  -webkit-text-stroke:1px rgba(80,130,200,.06);
  pointer-events:none;user-select:none;
}

.p-eyebrow{
  display:flex;align-items:center;gap:10px;margin-bottom:14px;
  font-family:var(--m);font-size:.52rem;letter-spacing:.24em;
  text-transform:uppercase;
}
.p-eyebrow::before{content:'';width:18px;height:1px}

.p-name{
  font-family:var(--d);font-weight:900;text-transform:uppercase;
  font-size:clamp(2.4rem,4vw,4.2rem);letter-spacing:-.01em;
  line-height:.92;color:#fff;margin-bottom:8px;
}
.p-loc{
  font-family:var(--m);font-size:.54rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--dim);margin-bottom:28px;
}
.p-desc{
  font-size:.95rem;line-height:1.75;color:rgba(196,212,228,.6);
  max-width:380px;margin-bottom:30px;
}
.p-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:36px}
.p-tag{
  padding:4px 11px;border:1px solid var(--bd);
  font-family:var(--m);font-size:.48rem;letter-spacing:.1em;
  text-transform:uppercase;color:var(--dim);
  background:rgba(8,13,24,.7);
  transition:border-color .2s,color .2s;
}
.p-link{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--m);font-size:.6rem;letter-spacing:.14em;
  text-transform:uppercase;
  border-bottom:1px solid;padding-bottom:2px;
  transition:opacity .2s;width:fit-content;
}
.p-link:hover{opacity:.7}

/* Partner color themes */
[data-p="portwell"] .p-eyebrow{color:var(--blue)}
[data-p="portwell"] .p-eyebrow::before{background:var(--blue)}
[data-p="portwell"] .p-name{color:var(--blue)}
[data-p="portwell"] .p-link{color:var(--blue);border-color:rgba(0,184,255,.3)}
[data-p="portwell"] .p-tag:hover{border-color:var(--blue);color:var(--blue)}

[data-p="lce"] .p-eyebrow{color:var(--green)}
[data-p="lce"] .p-eyebrow::before{background:var(--green)}
[data-p="lce"] .p-name{color:var(--green)}
[data-p="lce"] .p-link{color:var(--green);border-color:rgba(0,212,144,.3)}
[data-p="lce"] .p-tag:hover{border-color:var(--green);color:var(--green)}

[data-p="brightworks"] .p-eyebrow{color:var(--gold)}
[data-p="brightworks"] .p-eyebrow::before{background:var(--gold)}
[data-p="brightworks"] .p-name{color:var(--gold)}
[data-p="brightworks"] .p-link{color:var(--gold);border-color:rgba(232,148,26,.3)}
[data-p="brightworks"] .p-tag:hover{border-color:var(--gold);color:var(--gold)}

/* Visual panels */
.p-visual{
  position:relative;overflow:hidden;
  background:var(--bg2);
  display:flex;align-items:center;justify-content:center;
}
.p-visual::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(8,13,24,.6) 0%,transparent 60%);
  pointer-events:none;
}
.p-visual svg{width:75%;max-width:380px;position:relative;z-index:1}

/* ═══════ STATS BAR ═══════ */
.stats-bar{
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);
  background:var(--bg2);
}
.stat{
  padding:52px 44px;border-right:1px solid var(--bd);
}
.stat:last-child{border-right:none}
.stat-n{
  font-family:var(--d);font-weight:900;
  font-size:clamp(2.2rem,3.5vw,3.4rem);
  color:#fff;line-height:1;margin-bottom:8px;
}
.stat-l{
  font-family:var(--m);font-size:.5rem;letter-spacing:.18em;
  text-transform:uppercase;color:var(--dim);
}

/* ═══════ MARKETS ═══════ */
#markets{padding:110px 72px;border-bottom:1px solid var(--bd)}
.mkt-header{margin-bottom:60px}
.section-eye{
  display:flex;align-items:center;gap:10px;margin-bottom:12px;
  font-family:var(--m);font-size:.52rem;letter-spacing:.24em;
  text-transform:uppercase;color:var(--blue);opacity:.7;
}
.section-eye::before{content:'';width:18px;height:1px;background:var(--blue)}
.mkt-title{
  font-family:var(--d);font-weight:900;text-transform:uppercase;
  font-size:clamp(2rem,3.5vw,3.2rem);color:#fff;line-height:.92;
}
.mkt-grid{
  display:grid;grid-template-columns:repeat(6,1fr);
  gap:1px;background:var(--bd);
}
.mkt-tile{
  background:var(--bg);padding:36px 24px 32px;
  display:flex;flex-direction:column;align-items:flex-start;gap:20px;
  transition:background .3s;
}
.mkt-tile:hover{background:var(--bg2)}
.mkt-icon{opacity:.55;transition:opacity .3s;flex-shrink:0}
.mkt-tile:hover .mkt-icon{opacity:.9}
.mkt-name{
  font-family:var(--d);font-weight:700;font-size:1rem;
  text-transform:uppercase;letter-spacing:.04em;
  color:rgba(196,212,228,.65);transition:color .3s;
}
.mkt-tile:hover .mkt-name{color:var(--text)}

/* ═══════ CONTACT / CTA ═══════ */
#contact{
  padding:140px 72px;position:relative;
  overflow:hidden;background:var(--bg);
}
.cta-glow{
  position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse at 50% 110%,rgba(0,184,255,.07) 0%,transparent 55%);
}
.cta-inner{
  position:relative;z-index:1;text-align:center;
  max-width:720px;margin:0 auto;
}
.cta-label{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--m);font-size:.52rem;letter-spacing:.24em;
  text-transform:uppercase;color:var(--blue);opacity:.7;
  margin-bottom:24px;
}
.cta-label::before,.cta-label::after{content:'';flex:1;height:1px;background:var(--blue);opacity:.3;width:40px}
.cta-title{
  font-family:var(--d);font-weight:900;text-transform:uppercase;
  font-size:clamp(3rem,7vw,6.5rem);line-height:.88;color:#fff;
  margin-bottom:28px;
}
.cta-title .outline{
  display:block;color:transparent;
  -webkit-text-stroke:1px rgba(0,184,255,.4);
}
.cta-sub{
  font-size:.95rem;line-height:1.7;color:rgba(196,212,228,.45);
  max-width:480px;margin:0 auto 48px;
}
.cta-btn{
  display:inline-flex;align-items:center;gap:12px;
  padding:16px 40px;background:var(--blue-dim);
  border:1px solid rgba(0,184,255,.4);color:var(--blue);
  font-family:var(--m);font-size:.68rem;letter-spacing:.18em;
  text-transform:uppercase;
  transition:background .2s,border-color .2s,color .2s,transform .2s;
}
.cta-btn:hover{background:rgba(0,184,255,.2);border-color:var(--blue);color:#fff;transform:translateY(-2px)}
.cta-btn-arrow{transition:transform .2s}
.cta-btn:hover .cta-btn-arrow{transform:translate(2px,-2px)}

/* ═══════ FOOTER ═══════ */
footer{
  padding:28px 72px;border-top:1px solid var(--bd);
  display:flex;align-items:center;justify-content:space-between;
  background:var(--bg);
}
.ft-left{
  font-family:var(--m);font-size:.5rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--dim);
}
.ft-links{display:flex;gap:28px;flex-wrap:wrap}
.ft-link{
  font-family:var(--m);font-size:.5rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--dim);
  transition:color .2s;
}
.ft-link:hover{color:var(--text)}

/* ═══════ SCROLL REVEAL ═══════ */
.rv{opacity:0;transform:translateY(28px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.rv.vis{opacity:1;transform:none}
.rv-d1{transition-delay:.1s}.rv-d2{transition-delay:.2s}
.rv-d3{transition-delay:.3s}.rv-d4{transition-delay:.4s}

/* ═══════ SVG ANIMATIONS ═══════ */
@keyframes pulse-node{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes trace-draw{from{stroke-dashoffset:1000}to{stroke-dashoffset:0}}
@keyframes rf-pulse{0%{r:4;opacity:.9}100%{r:90;opacity:0}}
@keyframes wave-scroll{from{stroke-dashoffset:0}to{stroke-dashoffset:-120}}
@keyframes blink{0%,100%{opacity:.3}50%{opacity:1}}
@keyframes float-slow{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

/* ═══════ RESPONSIVE ═══════ */
@media(max-width:1100px){
  .p-card,.p-card.reverse{grid-template-columns:1fr;direction:ltr}
  .p-visual{min-height:320px}
  .p-info,.p-card.reverse .p-info{padding:64px 48px}
  .mkt-grid{grid-template-columns:repeat(3,1fr)}
  .stats-bar{grid-template-columns:repeat(2,1fr)}
  .stat:nth-child(2){border-right:none}
  .stat:nth-child(3){border-top:1px solid var(--bd)}
  nav{padding:16px 28px}
  #markets{padding:80px 48px}
  #contact{padding:100px 48px}
  footer{padding:24px 48px}
}
@media(max-width:680px){
  .nav-links{display:none}
  #hero{padding:68px 24px 80px}
  .h-strip{flex-direction:column}
  .h-strip-item{border-right:none;border-top:1px solid var(--bd);padding:16px 24px}
  .h-strip-item:first-child{border-top:1px solid var(--bd)}
  .p-info,.p-card.reverse .p-info{padding:48px 24px}
  .p-bg-num{font-size:26vw;right:-10px}
  .mkt-grid{grid-template-columns:repeat(2,1fr)}
  .stats-bar{grid-template-columns:1fr 1fr}
  .stat{padding:36px 28px}
  .stat:nth-child(2){border-right:none}
  .stat:nth-child(odd):not(:first-child){border-top:1px solid var(--bd)}
  #markets{padding:60px 24px}
  #contact{padding:80px 24px}
  footer{padding:24px;flex-direction:column;gap:16px;text-align:center}
  .ft-links{justify-content:center}
  nav{padding:14px 20px}
}
</style>
</head>
<body>

<!-- Cursor -->
<div id="cur"></div>
<div id="cur-ring"></div>

<!-- NAV -->
<nav id="mainNav">
  <div class="nav-logo">CAMM · REPS</div>
  <div class="nav-links">
    <a href="#partners">Partners</a>
    <a href="#markets">Markets</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<!-- ════ HERO ════ -->
<section id="hero">
  <canvas id="heroCanvas"></canvas>
  <div class="h-vignette"></div>

  <div class="h-content">
    <div class="h-overline">Est. San Diego, California &nbsp;·&nbsp; Component Manufacturing Representatives</div>
    <h1 class="h-title">
      <span>CAMM</span>
      <span class="ghost">REPS</span>
    </h1>
    <p class="h-sub">Advanced Components. Intelligent Solutions.</p>
    <p class="h-desc">Three world-class technology partners. One expert network connecting critical industries across Southern California and beyond.</p>
    <a href="#partners" class="h-cta">Explore Partners <span class="h-cta-arr">↓</span></a>
  </div>

  <div class="h-strip">
    <a href="#portwell" class="h-strip-item" data-color="blue">
      <span class="h-strip-label">Partner 01</span>
      <span class="h-strip-name">Portwell America</span>
    </a>
    <a href="#lce" class="h-strip-item" data-color="green">
      <span class="h-strip-label">Partner 02</span>
      <span class="h-strip-name">Left Coast Engineering</span>
    </a>
    <a href="#brightworks" class="h-strip-item" data-color="gold">
      <span class="h-strip-label">Partner 03</span>
      <span class="h-strip-name">Brightworks Technologies</span>
    </a>
  </div>
</section>

<!-- ════ PARTNERS ════ -->
<section id="partners">

  <!-- 01 — PORTWELL -->
  <article id="portwell" class="p-card" data-p="portwell">
    <div class="p-info rv">
      <span class="p-bg-num">01</span>
      <div class="p-eyebrow">Partner 01</div>
      <h2 class="p-name">Portwell<br>America</h2>
      <p class="p-loc">San Jose, CA &nbsp;·&nbsp; ASUS Group</p>
      <p class="p-desc">Industrial-grade embedded computing platforms engineered for edge AI, IoT gateways, and mission-critical deployments. From COM Express modules to rugged rackmount systems — built for the environments others can't handle.</p>
      <div class="p-tags">
        <span class="p-tag">Embedded Computing</span>
        <span class="p-tag">Edge AI</span>
        <span class="p-tag">COM Express</span>
        <span class="p-tag">Network Appliances</span>
        <span class="p-tag">Industrial IoT</span>
        <span class="p-tag">Rugged Systems</span>
      </div>
      <a href="https://www.portwell.com" target="_blank" rel="noopener" class="p-link">portwell.com ↗</a>
    </div>
    <div class="p-visual rv rv-d2">
      <!-- Portwell: Compute Grid SVG -->
      <svg viewBox="0 0 380 320" fill="none" xmlns="http://www.w3.org/2000/svg" style="animation:float-slow 6s ease-in-out infinite">
        <!-- Background trace grid -->
        <line x1="40" y1="0" x2="40" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="100" y1="0" x2="100" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="160" y1="0" x2="160" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="220" y1="0" x2="220" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="280" y1="0" x2="280" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="340" y1="0" x2="340" y2="320" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="0" y1="60" x2="380" y2="60" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="0" y1="120" x2="380" y2="120" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="0" y1="180" x2="380" y2="180" stroke="rgba(0,184,255,.05)" stroke-width="1"/>
        <line x1="0" y1="240" x2="380" y2="240" stroke="rgba(0,184,255,.05)" stroke-width="1"/>

